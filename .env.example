# Supabase (cloud free tier or self-hosted Docker). Leave empty to run in DEMO MODE
# (content is stored in your browser so you can try the site and CMS immediately).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Storage driver for uploads: "supabase" (Supabase Storage bucket) or "s3" (Cloudflare R2 /
# Backblaze B2 / MinIO via the `storage-presign` edge function). Bucket secrets live ONLY in
# edge-function secrets, never here.
VITE_STORAGE_DRIVER=supabase
VITE_STORAGE_BUCKET=media
# Public base URL of the bucket when using s3 (e.g. https://media.basilmedia.co.tz)
VITE_STORAGE_PUBLIC_URL=
