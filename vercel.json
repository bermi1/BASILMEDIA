{
  "rewrites": [
    {
      "source": "/((?!assets/|media/|api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/news-ingest",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "api/news.mjs": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
